{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SyncStatusSummaryResponseDto",
  "type": "object",
  "required": [
    "tenantCode",
    "totalEntities",
    "completed",
    "pending",
    "processing",
    "failed",
    "evaluatedAt"
  ],
  "properties": {
    "tenantCode": {
      "type": "string"
    },
    "totalEntities": {
      "type": "integer",
      "minimum": 0
    },
    "completed": {
      "type": "integer",
      "minimum": 0
    },
    "pending": {
      "type": "integer",
      "minimum": 0
    },
    "processing": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
