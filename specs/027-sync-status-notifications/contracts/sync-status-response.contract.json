{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SyncStatusResponseDto",
  "type": "object",
  "required": [
    "sourceType",
    "sourceId",
    "status",
    "affectedUserCount",
    "nextExpectedSyncMethod"
  ],
  "properties": {
    "sourceType": {
      "type": "string",
      "enum": ["USER_GROUP", "ROLE"]
    },
    "sourceId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED"]
    },
    "lastSuccessfulSyncAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "affectedUserCount": {
      "type": "integer",
      "minimum": 0
    },
    "nextExpectedSyncMethod": {
      "type": "string",
      "enum": ["MANUAL_IN_FLIGHT", "SCHEDULED_DAILY", "NONE"]
    },
    "activeJob": {
      "type": ["object", "null"],
      "properties": {
        "jobId": { "type": "string", "format": "uuid" },
        "triggerType": { "type": "string", "enum": ["MANUAL", "SCHEDULED", "SYSTEM"] },
        "progress": {
          "type": "object",
          "properties": {
            "processed": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          },
          "required": ["processed", "total"]
        },
        "error": {
          "type": ["object", "null"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "required": ["code", "message"]
        },
        "retryable": { "type": "boolean" }
      },
      "required": ["jobId", "triggerType", "progress", "retryable"]
    }
  }
}
