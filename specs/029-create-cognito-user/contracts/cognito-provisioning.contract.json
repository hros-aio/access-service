{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProvisionCognitoUserInput",
  "type": "object",
  "required": ["userId", "email", "tenantCode"],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "Internal User entity ID"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "User email address (will be normalized)"
    },
    "tenantCode": {
      "type": "string",
      "description": "Unique tenant identifier for organizational scoping"
    },
    "userType": {
      "type": "string",
      "description": "User category such as admin or employee",
      "default": "employee"
    },
    "suppressNotification": {
      "type": "boolean",
      "description": "Whether to suppress AWS Cognito's default welcome/temporary password email",
      "default": true
    }
  },
  "additionalProperties": false
}
