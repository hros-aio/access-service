{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CognitoUserProvisionedSecurityEvent",
  "type": "object",
  "required": ["eventId", "tenantCode", "eventType", "timestamp", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantCode": {
      "type": "string"
    },
    "eventType": {
      "type": "string",
      "enum": ["authentication.cognito-user-provisioned"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": ["userId", "normalizedEmail", "externalIdentityId", "action"],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "normalizedEmail": {
          "type": "string",
          "format": "email"
        },
        "externalIdentityId": {
          "type": "string",
          "description": "AWS Cognito sub identifier"
        },
        "action": {
          "type": "string",
          "enum": ["CREATED", "LINKED_EXISTING"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
