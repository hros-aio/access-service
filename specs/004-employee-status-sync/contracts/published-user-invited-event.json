{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PublishedUserInvitedEvent",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "The user who was reactivated and invited."
    },
    "tenantCode": {
      "type": "string",
      "description": "The tenant code of the user."
    },
    "invitationId": {
      "type": "string",
      "format": "uuid",
      "description": "The newly generated invitation identifier."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "The destination email address for the invite (non-sensitive details only, no token)."
    }
  },
  "required": ["userId", "tenantCode", "invitationId", "email"]
}
